{
  "model_config": {
    "d_model": 384,
    "n_heads": 12,
    "n_layers": 12,
    "max_position_embeddings": 512,
    "dropout": 0.15,
    "vocab_size": 6144
  },
  "training_config": {
    "batch_size": 8,
    "block_size": 512,
    "learning_rate": 0.0001,
    "train_steps": 2000,
    "num_epochs": 1,
    "eval_interval": 200,
    "eval_iters": 80,
    "warmup_steps": 200,
    "weight_decay": 0.01,
    "lr_scheduler": {
      "type": "cosine",
      "min_lr": 1e-05,
      "num_cycles": 0.5
    },
    "early_stopping": {
      "enabled": true,
      "patience_evals": 8,
      "min_delta": 0.001
    },
    "resume_from": null,
    "save": {
      "save_last": true,
      "save_best": true,
      "finalize_model_as": "best"
    }
  },
  "project_metadata": {
    "model_name": "gpt-bpe-v8",
    "model_save_path": "llm/language_models/elephantdomain_gpt/",
    "tokenizer_save_path": "llm/tokenizers/bpe-elephant/v4/tokenizer.json",
    "data_path": "llm/mixed_text/out",
    "data_file": "train.txt",
    "val_file": "val.txt",
    "test_file": "test.txt",
    "max_seq_length": 512,
    "max_new_tokens": 120
  },
  "tokenizer_config": {
    "type": "byte_bpe",
    "vocab_size": 6144,
    "min_freq": 2,
    "special_tokens": [
      "<pad>",
      "<unk>",
      "<bos>",
      "<eos>"
    ]
  },
  "inference_config": {
    "seed": 42,
    "temperature": 0.3,
    "top_k": 20,
    "top_p":0.9,
    "repetition_penalty": 1.15,
    "no_repeat_ngram_size": 4,
    "avoid_eos_first_n": 20
  },
  "data_pipeline": {
    "data_generation": true,
    "cleanup_generated_on_start": true,
    "cleanup_raw_generated_on_start": true,
    "min_len": 10,
    "max_len": 8000,
    "splits": [
      0.8,
      0.1,
      0.1
    ],
    "max_tokens_use_tokenizer": true,
    "seed": 42,
    "ngram_cap_n": 3,
    "ngram_cap_max": 30,
    "max_tokens": 512,
    "max_synth_lines": 2000,
    "advanced_synth_count": 500,
    "web_scrape_max_items": 1000,
    "drop_urls": true,
    "strip_discourse": true,
    "strip_overview": true,
    "require_domain": false,
    "prefix_cap_words": 12,
    "prefix_cap_max": 3,
    "dataset_subdir": "llm/mixed_text",
    "template_cap_words": 10,
    "template_cap_max": 3,
    "raw_subdir": "raw",
    "out_subdir": "out",
    "base_corpus_name": "elephant_human_90_10_corpus.txt",
    "synthetic_file_name": "synthetic_generated.txt",
    "combined_file_name": "corpus_all_sources_combined.txt",
    "dedup_file_name": "corpus_final_dedup.txt",
    "drop_short_questions": true,
    "question_max_tokens": 80,
    "question_max_chars": 200,
    "data_patterns": [
      "synthetic_generated.txt",
      "advanced_synthetic*.txt",
      "web_scraped*.txt",
      "augmented*.txt",
      "*synthetic*.txt",
      "*augmented*.txt",
      "*scraped*.txt"
    ],
    "prepare_shuffle": true,
    "prepare_dedupe": false,
    "cleanup_keep_files": [],
    "cleanup_out_on_start": true,
    "key_output_files": [
      "train.txt",
      "val.txt",
      "test.txt"
    ]
  }
}
